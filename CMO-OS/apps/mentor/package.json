  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
