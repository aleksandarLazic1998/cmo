# CMO OS AI Mentor — copy to .env.local and fill in. Never commit real secrets.

# AI provider: "anthropic" for the real Claude API, "mock" for offline/deterministic mode.
MENTOR_AI_PROVIDER=mock
# Required only when MENTOR_AI_PROVIDER=anthropic. Read server-side only.
ANTHROPIC_API_KEY=
# Model and request controls (defaults shown).
MENTOR_AI_MODEL=claude-opus-5-5
MENTOR_AI_EFFORT=medium
MENTOR_AI_TIMEOUT_MS=60000
MENTOR_AI_MAX_TOKENS=16000
# Server-side refusal fallback (Claude API beta). Set to "off" to disable.
MENTOR_AI_FALLBACKS=default
# Max AI calls per minute for this local process.
MENTOR_AI_RATE_LIMIT_PER_MIN=20

# Operational session database (auxiliary record; not canonical progress).
MENTOR_DB_PATH=./data/mentor.db

# Canonical progress writes to ../../10_Daily/Learning_Progress.md.
# Approved by the user on 2026-11-04 (ADR 009). Writes still require a passed attempt, typed confirmation, backup and validation.
MENTOR_CANONICAL_WRITES=true
# Optional override of the CMO-OS root (folder containing AUTHORITY.md).
# CMO_OS_ROOT=
